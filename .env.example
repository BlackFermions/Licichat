# Copy to `.env` and fill with your own values (do not commit `.env`).

# Azure OpenAI / OpenAI-compatible settings
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_API_VERSION=2024-12-01-preview

# Deployments (Azure)
CHAT_DEPLOYMENT=gpt-4o-mini
OPENAI_DEPLOYMENT=text-embedding-3-small

# Servicio paralelo licigob-ai-lite
LITE_SERVICE_KEY=replace-with-a-long-random-secret
SEACE_ALLOWED_HOSTS=prod1.seace.gob.pe,prod2.seace.gob.pe,prod3.seace.gob.pe,prod4.seace.gob.pe
SEACE_DOCUMENT_PROXY_URL=
SEACE_DOCUMENT_PROXY_KEY=
LITE_MAX_DOCUMENTS=2
LITE_MAX_FILE_BYTES=52428800
LITE_MAX_TOTAL_PAGES=120
LITE_MAX_TOTAL_CHARS=600000
LITE_MAX_CONTEXT_CHARS=18000
LITE_CACHE_TTL_DAYS=14
LITE_MEMORY_CACHE_SECONDS=1800

# Piloto de ingesta documental por lotes
AI_PIPELINE_VERSION=pilot-v1
AI_STORAGE_PROVIDER=azure_blob
AI_BLOB_ACCOUNT_URL=
AI_BLOB_CONTAINER=licigob-ai-documents
AI_ORIGINAL_RETENTION_DAYS=30
AI_JOB_BATCH_SIZE=10
AI_JOB_MAX_ATTEMPTS=4
AI_DOWNLOAD_MAX_FILE_BYTES=52428800
AI_ARCHIVE_MAX_FILES=30
AI_ARCHIVE_MAX_UNCOMPRESSED_BYTES=157286400
AI_ARCHIVE_MAX_DEPTH=1
AI_NATIVE_TEXT_MIN_CHARS_PER_PAGE=80
AI_OCR_MAX_PAGES_PER_DOCUMENT=60
AI_CHUNK_TARGET_TOKENS=850
AI_CHUNK_OVERLAP_TOKENS=100

# Database (Postgres / pgvector)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432
DB_SSLMODE=require

# App
PORT=5007
FLASK_ENV=production

